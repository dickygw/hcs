{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrasi": "tsx --env-file-if-exists=../.env src/db/migrasi.ts",
    "db:seed": "tsx --env-file-if-exists=../.env src/db/seed.ts",
    "cek:rls": "tsx --env-file-if-exists=../.env src/db/cek-rls.ts",
    "db:tambah-pengguna": "tsx --env-file-if-exists=../.env src/db/tambah-pengguna.ts"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "express": "5.2.1",
    "google-auth-library": "11.2.0",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
