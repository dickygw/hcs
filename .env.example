# Salin file ini menjadi .env lalu isi nilainya. File .env TIDAK BOLEH di-commit.
# Nilai produksi diisi langsung di dasbor Cloudways, bukan di file.

# --- Backend ---
PORT=4000
HOST=127.0.0.1

# --- Frontend ---
# Alamat backend yang dipakai Next.js untuk meneruskan /api/...
API_INTERNAL_URL=http://localhost:4000

# --- Database Supabase (hcs-dev saja; produksi diisi di Cloudways) ---
# Peran migrasi (postgres). HANYA di laptop pengelola, tidak pernah di Cloudways.
DATABASE_URL_MIGRASI=
# Peran aplikasi hcs_app (password minimal 32 karakter acak). Tanpa "sslmode".
DATABASE_URL=
# Sertifikat CA Supabase untuk SSL terverifikasi
DATABASE_CA_FILE=../database/supabase-ca.crt
# Kunci enkripsi rekening TAD: 32 byte base64
ENCRYPTION_KEY=

# --- Supabase Storage (S3 access key) ---
SUPABASE_S3_ENDPOINT=
SUPABASE_S3_REGION=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=

# --- Diisi pada tahap berikutnya ---
# Tahap 3: GOOGLE_CLIENT_ID, SESSION_SECRET
# Tahap 12: SMTP_USER, SMTP_APP_PASSWORD
