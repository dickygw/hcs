{
  "name": "hcs",
  "private": true,
  "description": "HCS (Human Capital System) — PT Pegadaian Kanwil IV Balikpapan, Google Apps Script",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node alat/bangun.mjs",
    "typecheck": "tsc --noEmit -p apps-script && tsc --noEmit -p tampilan",
    "test": "vitest run",
    "cek:keamanan": "node alat/cek-keamanan.mjs",
    "kirim:dev": "npm run build && npm run cek:keamanan && cd apps-script && npx --yes @google/clasp@3.4.1 push --force"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/google-apps-script": "2.0.13",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "esbuild": "0.28.2",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
